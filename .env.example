# ---------------------------------------------------------------------------
# Arise — environment configuration
# Copy to `.env.local` and fill in your own values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project settings → Project Settings → Data API
# Use the *anon / publishable* key ONLY. The service-role key bypasses RLS and
# must never be exposed to a browser bundle. Arise does not need it at all.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: set to "true" to print verbose Supabase/PostgREST errors in the
# browser console while developing. Keep "false" in production — user-facing
# copy never exposes raw database errors.
VITE_DEBUG_SUPABASE=false
