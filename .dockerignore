# Keep the build context small and, more importantly, keep secrets out of it.
# A .env file that reaches the daemon can end up in an image layer, and those
# layers persist in registries and caches even after the file is deleted.
.env
.env.*
!.env.example
*.pem
*.key

# Build output and dependencies are produced inside the image.
node_modules
dist
coverage
.vite

# Version control and CI
.git
.gitignore
.github

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Docs and local config
README.md
compose.yaml
compose.local.yaml
